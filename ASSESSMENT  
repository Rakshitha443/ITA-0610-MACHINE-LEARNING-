        "def candidate_elimination_trace(dataset, attributes, domain):\n",
        "    \"\"\"Traces Candidate Elimination step-by-step and detects Version Space collapse.\"\"\"\n",
        "    num_attrs = len(attributes)\n",
        "    S = [['Ø'] * num_attrs]\n",
        "    G = [['?'] * num_attrs]\n",
        "\n",
        "    def satisfies(h, example):\n",
        "        \"\"\"Checks if instance satisfies hypothesis h.\"\"\"\n",
        "        return all(h[i] == '?' or h[i] == example[i] for i in range(len(h)))\n",
        "\n",
        "    def is_more_general(h1, h2):\n",
        "        \"\"\"Returns True if h1 is at least as general as h2.\"\"\"\n",
        "        for v1, v2 in zip(h1, h2):\n",
        "            if v1 != '?' and (v1 != v2 and v2 != 'Ø'):\n",
        "                return False\n",
        "        return True\n",
        "\n",
        "    print(\"Initial State:\")\n",
        "    print(f\"S0 = {S}\")\n",
        "    print(f\"G0 = {G}\\n\" + \"-\"*50)\n",
        "\n",
        "    for idx, (features, label) in enumerate(dataset, 1):\n",
        "        print(f\"Processing Example {idx}: {features} -> {label}\")\n",
        "\n",
        "        if label.lower() == 'yes':\n",
        "            # Remove inconsistent hypotheses from G\n",
        "            G = [g for g in G if satisfies(g, features)]\n",
        "\n",
        "            # Generalize S\n",
        "            new_S = []\n",
        "            for s in S:\n",
        "                if not satisfies(s, features):\n",
        "                    gen = list(s)\n",
        "                    for i in range(num_attrs):\n",
        "                        if gen[i] == 'Ø':\n",
        "                            gen[i] = features[i]\n",
        "                        elif gen[i] != features[i]:\n",
        "                            gen[i] = '?'\n",
        "                    new_S.append(gen)\n",
        "                else:\n",
        "                    new_S.append(s)\n",
        "\n",
        "            # Keep minimal general elements in S\n",
        "            S = [s for s in new_S if not any(is_more_general(other, s) and s != other for other in new_S)]\n",
        "            # Prune S elements that are not covered by at least one G\n",
        "            S = [s for s in S if any(is_more_general(g, s) for g in G)]\n",
        "\n",
