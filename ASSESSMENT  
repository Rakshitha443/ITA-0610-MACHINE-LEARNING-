        "# ==========================================\n",
        "# CELL 1: FIND-S and Candidate Elimination\n",
        "# ==========================================\n",
        "\n",
        "def find_s(dataset, attributes):\n",
        "    \"\"\"Executes the FIND-S algorithm on a given dataset.\"\"\"\n",
        "    # Initialize most specific hypothesis\n",
        "    h = ['Ø'] * len(attributes)\n",
        "\n",
        "    print(\"--- FIND-S Execution Trace ---\")\n",
        "    print(f\"Initial h0: {h}\")\n",
        "\n",
        "    for idx, row in enumerate(dataset):\n",
        "        features, label = row[:-1], row[-1]\n",
        "        if label.lower() == 'yes':\n",
        "            if h == ['Ø'] * len(attributes):\n",
        "                h = list(features)\n",
        "            else:\n",
        "                for i in range(len(attributes)):\n",
        "                    if h[i] != features[i]:\n",
        "                        h[i] = '?'\n",
        "            print(f\"After Ex {idx+1} (Positive): h = {h}\")\n",
        "        else:\n",
        "            print(f\"After Ex {idx+1} (Negative): Ignored\")\n",
        "\n",
        "    return h\n",
        "\n",
        "def candidate_elimination(dataset, attributes):\n",
        "    \"\"\"Executes the Candidate Elimination algorithm on a dataset.\"\"\"\n",
        "    num_attrs = len(attributes)\n",
        "    S = [['Ø'] * num_attrs]\n",
        "    G = [['?'] * num_attrs]\n",
        "\n",
        "    def is_consistent(h, example, label):\n",
        "        match = all(h[i] == '?' or h[i] == example[i] for i in range(len(h)))\n",
        "        return match if label.lower() == 'yes' else not match\n",
        "\n",
        "    def is_more_general(h1, h2):\n",
        "        \"\"\"Returns True if h1 is at least as general as h2.\"\"\"\n",
        "        for v1, v2 in zip(h1, h2):\n",
        "            if v1 != '?' and (v1 != v2 and v2 != 'Ø'):\n",
        "                return False\n",
        "        return True\n",
        "\n",
        "    print(\"--- Candidate Elimination Trace ---\")\n",
        "    print(f\"S0: {S}\")\n",
        "    print(f\"G0: {G}\")\n",
        "\n",
        "    for idx, row in enumerate(dataset):\n",
        "        features, label = row[:-1], row[-1]\n",
        "        print(f\"\\n--- Example {idx+1}: {features} -> {label} ---\")\n",
        "\n",
        "        if label.lower() == 'yes':\n",
        "            # Remove inconsistent hypotheses from G\n",
        "            G = [g for g in G if is_consistent(g, features, label)]\n",
        "\n",
        "            # Generalize S\n",
        "            new_S = []\n",
        "            for s in S:\n",
        "                if not is_consistent(s, features, label):\n",
        "                    # Minimal generalization\n",
        "                    generalized = list(s)\n",
        "                    for i in range(num_attrs):\n",
        "                        if generalized[i] == 'Ø':\n",
        "                            generalized[i] = features[i]\n",
        "                        elif generalized[i] != features[i]:\n",
        "                            generalized[i] = '?'\n",
        "                    new_S.append(generalized)\n",
        "                else:\n",
        "                    new_S.append(s)\n",
        "\n",
        "            # Remove hypotheses in S that are more general than another in S\n",
        "            S = [s for s in new_S if not any(is_more_general(other, s) and s != other for other in new_S)]\n",
        "\n",
        "            # Remove hypotheses in S that are not more specific than some member in G\n",
        "            S = [s for s in S if any(is_more_general(g, s) for g in G)]\n",
        "\n",
        "        else: # Negative example\n",
        "            # Remove inconsistent hypotheses from S\n",
        "            S = [s for s in S if is_consistent(s, features, label)]\n",
        "\n",
        "            # Specialize G\n",
        "            new_G = []\n",
        "            for g in G:\n",
        "                if not is_consistent(g, features, label):\n",
        "                    for i in range(num_attrs):\n",
        "                        if g[i] == '?':\n",
        "                            for s in S:\n",
        "                                if s[i] != '?' and s[i] != 'Ø':\n",
        "                                    spec = list(g)\n",
        "                                    spec[i] = s[i]\n",
        "                                    new_G.append(spec)\n",
        "                else:\n",
        "                    new_G.append(g)\n",
        "\n",
        "            # Remove hypotheses from G that are less general than another in G\n",
        "            G = [g for g in new_G if not any(is_more_general(g, other) and g != other for other in new_G)]\n",
        "\n",
        "            # Keep only hypotheses in G that are more general than at least one in S\n",
        "            G = [g for g in G if any(is_more_general(g, s) for s in S)]\n",
        "\n",
        "        print(f\"S{idx+1}: {S}\")\n",
        "        print(f\"G{idx+1}: {G}\")\n",
        "\n",
        "    return S, G\n",
        "\n",
