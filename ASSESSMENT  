        "\n",
        "def compare_hypotheses(h1, h2):\n",
        "    \"\"\"Compares partial ordering between two hypotheses.\"\"\"\n",
        "    def is_more_general_or_equal(a, b):\n",
        "        for val1, val2 in zip(a, b):\n",
        "            if val1 == 'Ø':\n",
        "                return False\n",
        "            if val1 != '?' and val1 != val2:\n",
        "                return False\n",
        "        return True\n",
        "\n",
        "    h1_gen_h2 = is_more_general_or_equal(h1, h2)\n",
        "    h2_gen_h1 = is_more_general_or_equal(h2, h1)\n",
        "\n",
        "    if h1 == h2:\n",
        "        return \"Equally general\"\n",
        "    elif h1_gen_h2 and not h2_gen_h1:\n",
        "        return \"h1 is more general than h2\"\n",
        "    elif h2_gen_h1 and not h1_gen_h2:\n",
        "        return \"h2 is more general than h1\"\n",
        "    else:\n",
        "        return \"Not comparable\"\n",
