        "def satisfies(hypothesis, instance):\n",
        "    \"\"\"Check if an instance satisfies a given hypothesis.\"\"\"\n",
        "    for h_val, inst_val in zip(hypothesis, instance):\n",
        "        if h_val != '?' and h_val != inst_val:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "def get_version_space(S, G, domain_values):\n",
        "    \"\"\"Generate all hypotheses that are at least as general as S\n",
        "    and at least as specific as at least one member of G.\"\"\"\n",
        "    import itertools\n",
        "\n",
        "    # Generate all possible syntactically non-empty hypotheses over the domain\n",
        "    keys = list(domain_values.keys())\n",
        "    value_options = [domain_values[k] + ['?'] for k in keys]\n",
        "    all_hypotheses = list(itertools.product(*value_options))\n",
        "\n",
        "    version_space = []\n",
        "\n",
        "    for h in all_hypotheses:\n",
        "        # Condition 1: h must be at least as general as S (must cover all positive instances covered by S)\n",
        "        # For single specific boundary element s:\n",
        "        s = S[0]\n",
        "        s_covered_by_h = all(h[i] == '?' or h[i] == s[i] or s[i] == '?' for i in range(len(h)))\n",
        "\n",
        "        # Condition 2: h must be at least as specific as at least one member in G\n",
        "        h_specific_to_g = any(\n",
        "            all(g[i] == '?' or g[i] == h[i] for i in range(len(h)))\n",
        "            for g in G\n",
        "        )\n",
        "\n",
        "        if s_covered_by_h and h_specific_to_g:\n",
        "            version_space.append(h)\n",
        "\n",
        "    return version_space\n",
        "\n",
        "# Define the domain attributes and possible values\n",
        "domain_values = {\n",
        "    'Sky': ['Sunny', 'Rainy'],\n",
        "    'AirTemp': ['Warm', 'Cold'],\n",
        "    'Wind': ['Strong', 'Weak']\n",
        "}\n",
        "\n",
        "# Version space boundaries given in Question 5\n",
        "S = [('Sunny', 'Warm', '?')]\n",
        "G = [('Sunny', '?', '?'), ('?', 'Warm', '?')]\n",
        "\n",
        "# Find all hypotheses inside the Version Space\n",
        "VS = get_version_space(S, G, domain_values)\n",
        "\n",
        "print(f\"Total hypotheses in Version Space: {len(VS)}\")\n",
        "print(\"Hypotheses in VS:\", VS)\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# Function to evaluate voting across the entire Version Space\n",
        "def evaluate_instance(instance, instance_label):\n",
        "    print(f\"\\n--- Testing {instance_label}: {instance} ---\")\n",
        "\n",
        "    votes = [satisfies(h, instance) for h in VS]\n",
        "    pos_votes = sum(votes)\n",
        "    neg_votes = len(votes) - pos_votes\n",
        "\n",
        "    print(f\"Votes -> Positive (Yes): {pos_votes}, Negative (No): {neg_votes}\")\n",
        "\n",
        "    if pos_votes == len(VS):\n",
        "        print(\"Verdict: Unanimous YES (Every hypothesis agrees on Positive)\")\n",
        "    elif neg_votes == len(VS):\n",
        "        print(\"Verdict: Unanimous NO (Every hypothesis agrees on Negative)\")\n",
        "    else:\n",
        "        print(\"Verdict: DISAGREEMENT / UNCERTAIN\")\n",
        "        print(\"Learner Action: Report UNCERTAIN (Split Vote).\")\n",
        "        print(\"Why: Reporting uncertainty is more honest than guessing because the target\")\n",
        "        print(\"     concept boundary has not been fully constrained by the training data.\")\n",
        "\n",
        "# Q10 Instance\n",
        "evaluate_instance(('Sunny', 'Warm', 'Strong'), \"Question 10 Instance\")\n",
        "\n",
