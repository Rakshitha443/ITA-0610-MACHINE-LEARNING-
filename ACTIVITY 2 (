# ============================================================
# Cell 1: Install/Import Libraries
# ============================================================
import pandas as pd
import numpy as np
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import DecisionTreeClassifier, export_text, plot_tree
import matplotlib.pyplot as plt

# ============================================================
# Cell 2: Step 1 - Data Representation
# ============================================================
data = {
    'Outlook':     ['Sunny', 'Sunny', 'Overcast', 'Rain', 'Rain', 'Rain', 'Overcast'],
    'Temperature': ['Hot', 'Hot', 'Hot', 'Mild', 'Cool', 'Cool', 'Mild'],
    'Humidity':    ['High', 'High', 'High', 'High', 'Normal', 'Normal', 'Normal'],
    'Wind':        ['Weak', 'Strong', 'Weak', 'Weak', 'Weak', 'Strong', 'Strong'],
    'PlayTennis':  ['No', 'No', 'Yes', 'Yes', 'Yes', 'No', 'Yes']
}
df = pd.DataFrame(data)
print("Original Dataset:")
print(df)

# ============================================================
# Cell 3: Encode categorical data
# ============================================================
# Use a separate encoder per column so we can decode/inspect later
encoders = {}
df_encoded = df.copy()
for col in df.columns:
    le = LabelEncoder()
    df_encoded[col] = le.fit_transform(df[col])
    encoders[col] = le  # store encoder to decode values later if needed

print("\nEncoded Dataset:")
print(df_encoded)

# Show the mapping for reference
print("\nEncoding mappings:")
for col, le in encoders.items():
    print(f"{col}: {dict(zip(le.classes_, le.transform(le.classes_)))}")

X = df_encoded.drop('PlayTennis', axis=1)
y = df_encoded['PlayTennis']

# ============================================================
# Cell 4: Step 2 - Apply Decision Tree Algorithm (Gini)
# ============================================================
model_gini = DecisionTreeClassifier(criterion='gini', random_state=42)
model_gini.fit(X, y)
print("Model Trained Successfully using Gini Index")

# ============================================================
# Cell 5: Step 3 - Heuristic Space Search (Split Evaluation) - Gini
# ============================================================
tree_rules_gini = export_text(model_gini, feature_names=list(X.columns))
print("Decision Tree Rules (Gini):")
print(tree_rules_gini)

# ============================================================
# Cell 6: Step 4 - Prediction
# ============================================================
# Example: Outlook=Overcast, Temperature=Mild, Humidity=Normal, Wind=Weak
# Check the encoding mapping printed above to build a matching sample
sample = pd.DataFrame([{
    'Outlook': encoders['Outlook'].transform(['Overcast'])[0],
    'Temperature': encoders['Temperature'].transform(['Mild'])[0],
    'Humidity': encoders['Humidity'].transform(['Normal'])[0],
    'Wind': encoders['Wind'].transform(['Weak'])[0],
}])

prediction = model_gini.predict(sample)
predicted_label = encoders['PlayTennis'].inverse_transform(prediction)
print("Sample:", sample.to_dict('records')[0])
print("Prediction:", predicted_label[0])

# ============================================================
# Cell 7: Task A2 - Compare with Entropy Criterion
# ============================================================
model_entropy = DecisionTreeClassifier(criterion='entropy', random_state=42)
model_entropy.fit(X, y)

tree_rules_entropy = export_text(model_entropy, feature_names=list(X.columns))
print("Decision Tree Rules (Entropy):")
print(tree_rules_entropy)

print("\n--- Comparison ---")
print("GINI tree structure:\n", tree_rules_gini)
print("ENTROPY tree structure:\n", tree_rules_entropy)
# Note: On such a small dataset, Gini and Entropy often produce identical
# or very similar splits, since both heuristics tend to agree when
# class separation is clear-cut in the data.

# ============================================================
# Cell 8: Apply Pruning (limit tree depth)
# ============================================================
model_pruned = DecisionTreeClassifier(criterion='gini', max_depth=3, random_state=42)
model_pruned.fit(X, y)

tree_rules_pruned = export_text(model_pruned, feature_names=list(X.columns))
print("Pruned Decision Tree Rules (max_depth=3):")
print(tree_rules_pruned)

# ============================================================
# Cell 9: Interpret Results - Identify Root Node & Splits
# ============================================================
root_feature_index = model_gini.tree_.feature[0]
root_feature_name = X.columns[root_feature_index]
root_threshold = model_gini.tree_.threshold[0]

print(f"Root node splits on: '{root_feature_name}'")
print(f"Split threshold (encoded value): {root_threshold}")
print(f"Root Gini impurity: {model_gini.tree_.impurity[0]:.4f}")
print(f"Samples at root: {model_gini.tree_.n_node_samples[0]}")

# ============================================================
# Cell 10: Visualize the Tree
# ============================================================
plt.figure(figsize=(14, 8))
plot_tree(model_gini,
          feature_names=X.columns,
          class_names=encoders['PlayTennis'].classes_,
          filled=True,
          rounded=True,
          fontsize=10)
plt.title("Decision Tree (Gini Index) - PlayTennis Dataset")
plt.show()

# ============================================================
# Cell 11: EXTENSION - Manual Information Gain Calculation
# ============================================================
def entropy(labels):
    """Calculate entropy of a list/array of labels."""
    values, counts = np.unique(labels, return_counts=True)
    probs = counts / counts.sum()
    return -np.sum(probs * np.log2(probs))

def information_gain(df, split_attribute, target_attribute='PlayTennis'):
    """Calculate Information Gain for splitting on a given attribute."""
    total_entropy = entropy(df[target_attribute])

    values, counts = np.unique(df[split_attribute], return_counts=True)
    weighted_entropy = 0
    for value, count in zip(values, counts):
        subset = df[df[split_attribute] == value]
        weighted_entropy += (count / len(df)) * entropy(subset[target_attribute])

    gain = total_entropy - weighted_entropy
    return gain

print("Total Entropy of PlayTennis:", round(entropy(df['PlayTennis']), 4))
print("\nInformation Gain per attribute:")
for attribute in ['Outlook', 'Temperature', 'Humidity', 'Wind']:
    gain = information_gain(df, attribute)
    print(f"  {attribute}: {gain:.4f}")

best_attribute = max(
    ['Outlook', 'Temperature', 'Humidity', 'Wind'],
    key=lambda attr: information_gain(df, attr)
)
print(f"\nBest attribute to split on (highest Information Gain): {best_attribute}")
print("Compare this with the root node sklearn selected above (Cell 9) —")
print("they should match, confirming sklearn's internal heuristic search.")
