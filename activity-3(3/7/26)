        "print(f\"Not Apple Score: {P_Not_Apple_given_features:.4f}\")\n",
        "\n",
        "if P_Apple_given_features > P_Not_Apple_given_features:\n",
        "  print(\"Updated Decision: Classified as Apple\")\n",
        "else:\n",
        "  print(\"Updated Decision: Classified as Not Apple\")\n",
        "  # Level 5: Extended Spam Email Classifier with Laplace Smoothing\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Extended Dataset\n",
        "dataset = [\n",
        "    # Offer, Win, Free, Click, Is_Spam\n",
        "    [1, 1, 1, 1, 1],  # Spam\n",
        "    [1, 0, 1, 0, 1],  # Spam\n",
        "    [1, 1, 0, 1, 1],  # Spam\n",
        "    [0, 1, 1, 0, 1],  # Spam\n",
        "    [0, 1, 0, 0, 0],  # Not Spam\n",
        "    [0, 0, 0, 0, 0],  # Not Spam\n",
        "    [1, 0, 0, 1, 0],  # Not Spam\n",
        "    [0, 0, 1, 0, 0],  # Not Spam\n",
        "]\n",
        "\n",
        "columns = [\"Offer\", \"Win\", \"Free\", \"Click\", \"Is_Spam\"]\n",
        "df = pd.DataFrame(dataset, columns=columns)\n",
        "\n",
        "\n",
        "class NaiveBayesSpamClassifier:\n",
        "\n",
        "  def __init__(self, alpha=1.0):\n",
        "    self.alpha = alpha  # Laplace Smoothing parameter\n",
        "\n",
        "  def fit(self, df):\n",
        "    self.total_docs = len(df)\n",
        "    self.spam_df = df[df[\"Is_Spam\"] == 1]\n",
        "    self.not_spam_df = df[df[\"Is_Spam\"] == 0]\n",
        "\n",
        "    # Prior Probabilities\n",
        "    self.P_Spam = len(self.spam_df) / self.total_docs\n",
        "    self.P_Not_Spam = len(self.not_spam_df) / self.total_docs\n",
        "\n",
        "  def _calculate_likelihood(self, feature, value, target_df):\n",
        "    # Laplace Smoothing: (count + alpha) / (total + alpha * 2)\n",
        "    count = (target_df[feature] == value).sum()\n",
        "    return (count + self.alpha) / (len(target_df) + 2 * self.alpha)\n",
        "\n",
        "  def predict(self, sample):\n",
        "    features = [\"Offer\", \"Win\", \"Free\", \"Click\"]\n",
        "\n",
        "    # Log-space probabilities to prevent underflow\n",
        "    log_p_spam = np.log(self.P_Spam)\n",
        "    log_p_not_spam = np.log(self.P_Not_Spam)\n",
        "\n",
        "    for feature in features:\n",
        "      val = sample[feature]\n",
        "      p_feat_spam = self._calculate_likelihood(feature, val, self.spam_df)\n",
        "      p_feat_not_spam = self._calculate_likelihood(feature, val, self.not_spam_df)\n",
        "      log_p_spam += np.log(p_feat_spam)\n",
        "      log_p_not_spam += np.log(p_feat_not_spam)\n",
        "\n",
        "    return 1 if log_p_spam > log_p_not_spam else 0\n",
        "\n",
        "\n",
        "# Train Classifier\n",
        "model = NaiveBayesSpamClassifier(alpha=1.0)\n",
        "model.fit(df)\n",
        "\n",
        "# Test Samples\n",
        "test_email_1 = {\"Offer\": 1, \"Win\": 1, \"Free\": 1, \"Click\": 1}\n",
        "test_email_2 = {\"Offer\": 0, \"Win\": 0, \"Free\": 0, \"Click\": 0}\n",
        "\n",
        "pred1 = model.predict(test_email_1)\n",
        "pred2 = model.predict(test_email_2)\n",
        "\n",
        "print(\"=\" * 55)\n",
        "print(\"             SPAM CLASSIFIER EVALUATION                  \")\n",
        "print(\"=\" * 55)\n",
        "print(f\"Test Email 1 [Offer=1, Win=1, Free=1, Click=1] -> {'SPAM' if pred1 == 1 else 'NOT SPAM'}\")\n",
        "print(f\"Test Email 2 [Offer=0, Win=0, Free=0, Click=0] -> {'SPAM' if pred2 == 1 else 'NOT SPAM'}\")\n",
        "print(\"=\" * 55)"
      ]
