      "source": [
        "# Level 1: Calculating Posterior Probability\n",
        "P_D = 0.01\n",
        "P_not_D = 0.99\n",
        "P_Pos_given_D = 0.95\n",
        "P_Pos_given_not_D = 0.10\n",
        "\n",
        "P_Pos = (P_Pos_given_D * P_D) + (P_Pos_given_not_D * P_not_D)  # Total Probability\n",
        "P_D_given_Pos = (P_Pos_given_D * P_D) / P_Pos\n",
        "\n",
        "print(f\"Posterior Probability P(Disease | Positive): {P_D_given_Pos:.4f}\")\n",
        "print(f\"Percentage: {P_D_given_Pos * 100:.2f}%\")\n",
        "# Level 2: Reliability Analysis\n",
        "if P_D_given_Pos > 0.5:\n",
        "  print(\"Test is reliable for diagnosis.\")\n",
        "else:\n",
        "  print(\"Test is NOT reliable for diagnosis despite 95% sensitivity.\")\n",
        "  # Level 3: Naïve Bayes Concept Classifier\n",
        "P_Apple = 0.6\n",
        "P_Not_Apple = 0.4\n",
        "\n",
        "P_Red_given_Apple = 0.8\n",
        "P_Round_given_Apple = 0.9\n",
        "\n",
        "P_Red_given_Not_Apple = 0.3\n",
        "P_Round_given_Not_Apple = 0.5\n",
        "\n",
        "# Joint Unnormalized Probabilities\n",
        "P_Apple_given_features = P_Apple * P_Red_given_Apple * P_Round_given_Apple\n",
        "P_Not_Apple_given_features = (\n",
        "    P_Not_Apple * P_Red_given_Not_Apple * P_Round_given_Not_Apple\n",
        ")\n",
        "\n",
        "print(f\"P(Apple | Red, Round) unnormalized     : {P_Apple_given_features:.4f}\")\n",
        "print(\n",
        "    f\"P(Not Apple | Red, Round) unnormalized : {P_Not_Apple_given_features:.4f}\"\n",
        ")\n",
        "\n",
        "if P_Apple_given_features > P_Not_Apple_given_features:\n",
        "  print(\"Decision: Classified as Apple\")\n",
        "else:\n",
        "  print(\"Decision: Classified as Not Apple\")\n",
        "  # Level 4: Feature Impact Analysis\n",
        "P_Red_given_Not_Apple = 0.7  # Modified Likelihood\n",
        "\n",
        "P_Not_Apple_given_features = (\n",
        "    P_Not_Apple * P_Red_given_Not_Apple * P_Round_given_Not_Apple\n",
        ")\n",
